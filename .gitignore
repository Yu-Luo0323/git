# ---------------------------------------------------------------
# General-purpose .gitignore
#
# This is a broad starting template. Delete the sections that do not
# apply to this project so the file stays readable.
# ---------------------------------------------------------------

# --- Operating system cruft ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*~

# --- Editors and IDEs ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.iml
*.swp
*.swo
*.sublime-workspace
.project
.classpath
.settings/

# --- Environment and secrets ---
# Never commit real credentials.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# --- Logs and temp files ---
*.log
logs/
tmp/
temp/
*.tmp

# --- Build output ---
build/
dist/
out/
bin/
obj/
target/
*.o
*.obj
*.exe
*.dll
*.so
*.dylib

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/
coverage/
.nyc_output/
.next/
.nuxt/
.cache/
*.tsbuildinfo

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.eggs/
build/
dist/

# --- Java / JVM ---
*.class
*.jar
*.war
*.ear
.gradle/
hs_err_pid*

# --- C / C++ ---
*.a
*.lib
*.out
*.gch
*.pch
CMakeCache.txt
CMakeFiles/
cmake-build-*/
Makefile.in

# --- Go ---
*.test
*.prof
vendor/

# --- Rust ---
Cargo.lock
**/*.rs.bk

# --- .NET ---
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userprefs
.vs/

# --- Archives and binaries ---
*.zip
*.tar
*.tar.gz
*.7z
*.rar
*.iso
*.dmg
